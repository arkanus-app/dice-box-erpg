{
  "name": "@erpg/dice3dview",
  "version": "2.6.0",
  "author": {
    "name": "Quir and Codex"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkanus-app/dice-box-erpg.git"
  },
  "main": "./dist/dice3dview.es.js",
  "module": "./dist/dice3dview.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dice3dview.es.js"
    },
    "./external": {
      "types": "./dist/index.d.ts",
      "import": "./dist/external/dice3dview.es.js"
    },
    "./adapters": {
      "types": "./dist/adapters/adapters.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./style.css": "./dist/dice3dview.css"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/chunks/*.js",
    "./dist/external/chunks/*.js"
  ],
  "devDependencies": {
    "@types/node": "^24.10.0",
    "playwright": "1.59.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^4.5.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "bugs": {
    "url": "https://github.com/arkanus-app/dice-box-erpg/issues"
  },
  "description": "TypeScript 3D presentation layer for externally resolved dice results, including themeable d2 coins.",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DEVLOG_V2.md",
    "FORK.md",
    "docs"
  ],
  "files-dev": [
    "src"
  ],
  "homepage": "https://github.com/arkanus-app/dice-box-erpg",
  "keywords": [
    "3D",
    "dice",
    "results",
    "viewer",
    "typescript",
    "rpg",
    "dnd",
    "d&d",
    "tabletop",
    "fate"
  ],
  "license": "MIT",
  "main-dev": "./src/index",
  "scripts": {
    "dev": "vite",
    "example": "vite --open /example/index.html",
    "themes:generate:vampire": "node scripts/generate-vampire-themes.mjs",
    "build": "npm run themes:check && tsc --noEmit && npm run build:bundles && npm run docs:check && npm run bundle:check",
    "build:bundles": "npm run build:legacy && npm run build:external && npm run build:adapters",
    "build:legacy": "vite build --mode legacy",
    "build:external": "vite build --mode external",
    "build:adapters": "vite build --mode adapters",
    "bundle:check": "node scripts/check-bundle.mjs",
    "bundle:metrics": "node scripts/bundle-metrics.mjs",
    "e2e:smoke": "node scripts/browser-smoke.mjs",
    "benchmark:physics": "node scripts/physics-benchmark.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "serve": "vite preview",
    "test": "tsx --test src/*.test.ts",
    "themes:check": "tsx --test src/systemThemeAssets.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@babylonjs/core": "9.18.0",
    "@babylonjs/havok": "^1.3.0"
  }
}
