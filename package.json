{
  "name": "@erpg/dice3dview",
  "version": "2.1.1",
  "author": {
    "name": "Quir and Codex"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arkanus-app/dice-box-erpg"
  },
  "main": "./dist/dice3dview.es.js",
  "module": "./dist/dice3dview.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dice3dview.es.js"
    },
    "./style.css": "./dist/dice3dview.css"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/chunks/*.js"
  ],
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^4.5.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "bugs": {
    "url": "https://github.com/arkanus-app/dice-box-erpg/issues"
  },
  "description": "TypeScript 3D presentation layer for externally resolved dice results, including themeable d2 coins.",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DEVLOG_V2.md",
    "FORK.md",
    "docs"
  ],
  "files-dev": [
    "src"
  ],
  "homepage": "https://github.com/arkanus-app/dice-box-erpg",
  "keywords": [
    "3D",
    "dice",
    "results",
    "viewer",
    "typescript",
    "rpg",
    "dnd",
    "d&d",
    "tabletop"
  ],
  "license": "MIT",
  "main-dev": "./src/index",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run docs:check && npm run bundle:check",
    "bundle:check": "node scripts/check-bundle.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "serve": "vite preview",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/havok": "^1.3.0"
  }
}
